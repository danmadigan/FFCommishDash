# Template for Streamlit secrets-based league storage.
#
# Local dev: copy this to .streamlit/secrets.toml (already gitignored) to
# test the secrets-backed flow before deploying.
#
# Streamlit Community Cloud: paste the contents (with real values filled
# in) into your app's Settings -> Secrets panel. Leagues configured this
# way survive app restarts/redeploys, unlike config.json, which lives on
# the app's ephemeral local disk.
#
# If no `leagues` key is present here, the app falls back to the local
# config.json file and its editable "Manage leagues" sidebar UI — so this
# file is entirely optional for local/single-machine use.

buy_in = 50

[[leagues]]
platform = "espn"
name = "ESPN League A"
league_id = 123456
espn_s2 = ""
swid = ""
start_year = 2019
current_year = 2026
my_team_id = 1

[[leagues]]
platform = "espn"
name = "ESPN League B"
league_id = 654321
espn_s2 = ""
swid = ""
start_year = 2020
current_year = 2026
my_team_id = 1

[[leagues]]
platform = "espn"
name = "ESPN League C"
league_id = 789012
espn_s2 = ""
swid = ""
start_year = 2021
current_year = 2026
my_team_id = 1

[[leagues]]
platform = "sleeper"
name = "Sleeper League A"
sleeper_league_id = ""
sleeper_username = ""

[[leagues]]
platform = "sleeper"
name = "Sleeper League B"
sleeper_league_id = ""
sleeper_username = ""
